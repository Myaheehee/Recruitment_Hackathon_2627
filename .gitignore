# --- OS / editor ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- ROS / colcon ---
race_ws/build/
race_ws/install/
race_ws/log/
workshop/ros2_ws/build/
workshop/ros2_ws/install/
workshop/ros2_ws/log/
# colcon output from building at the repo root. install/ itself holds tracked
# setup scripts, so ignore only what colcon writes there.
/build/
/log/
/install/.colcon_install_layout
/install/COLCON_IGNORE
/install/_local_setup_util_*.py
/install/local_setup.*
/install/setup.*
/install/f1tenth_gym_ros/
/install/my_package/
/install/team_driver/

# --- AutoDRIVE Simulator ---
# Not used on this track. It appears here only if you have switched branches
# from track2, where scripts/fetch_simulator.sh downloads ~250 MB of Unity
# binary. Ignored so it can never be committed to Track 1 by accident.
simulator/

# --- Docker helper state, written by install/<os>/run.sh ---
docker/.env
docker/.x11-placeholder/

# --- Evaluation output ---
# Keep the folder, ignore the practice runs. The one exception is
# results/submitted/, which is a required part of a submission: the runs you
# recorded on your own machine. See docs/07-submission.md.
results/*
!results/.gitkeep
!results/README.md
!results/submitted/

# --- Recordings ---
*.bag
rosbag2_*/

# Written by the CI integrity step if it is ever run inside the checkout
integrity.txt
install/